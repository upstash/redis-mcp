# --- Single database (the common case) ---

# HTTP / REST transport (from the Upstash console "REST API" section)
UPSTASH_REDIS_REST_URL="https://<your-db>.upstash.io"
UPSTASH_REDIS_REST_TOKEN="<your-rest-token>"

# ...or TCP transport (the rediss:// connection string from the console).
# If both REST and TCP are set for the default DB, REST (HTTP) wins.
# UPSTASH_REDIS_TCP_URL="rediss://default:<password>@<your-db>.upstash.io:6379"

# --- Multiple databases (optional) ---
# Add as many as you like with a NAME segment. Each becomes a selectable
# `database` value in the redis_run_commands tool.
#
# UPSTASH_REDIS_PROD_REST_URL="https://prod-db.upstash.io"
# UPSTASH_REDIS_PROD_REST_TOKEN="<prod-rest-token>"
# UPSTASH_REDIS_CACHE_TCP_URL="rediss://default:<password>@cache-db.upstash.io:6379"

# --- Behavior ---
# UPSTASH_REDIS_READONLY="true"        # best-effort: reject write commands
# UPSTASH_DISABLE_TELEMETRY="true"     # stop sending Upstash-Telemetry-* headers
